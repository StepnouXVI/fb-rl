{
    "latex-workshop.latex.outDir": "%DIR%/pdf",
    "latex-workshop.latex.autoClean.run": "onBuilt",
    "latex-workshop.latex.clean.subfolder.enabled": true,
    "latex-workshop.latex.tools": [
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-output-directory=%OUTDIR%",
                "%DOC%"
            ],
            "env": {
                "TEXMFCNF": "/usr/local/texlive/2026/texmf-dist/web2c:",
                "PATH": "/Library/TeX/texbin:/usr/local/bin:/usr/bin:/bin:$PATH"
            }
        },
        {
            "name": "bibtex",
            "command": "bibtex",
            "args": [
                "%OUTDIR%/%DOCFILE%"
            ],
            "env": {
                "TEXMFCNF": "/usr/local/texlive/2026/texmf-dist/web2c:",
                "PATH": "/Library/TeX/texbin:/usr/local/bin:/usr/bin:/bin:$PATH"
            }
        },
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ],
            "env": {
                "TEXMFCNF": "/usr/local/texlive/2026/texmf-dist/web2c:",
                "PATH": "/Library/TeX/texbin:/usr/local/bin:/usr/bin:/bin:$PATH"
            }
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "pdflatex ➞ bibtex ➞ pdflatex`×2",
            "tools": [
                "pdflatex",
                "bibtex",
                "pdflatex",
                "pdflatex"
            ]
        },
        {
            "name": "pdfLaTeX",
            "tools": [
                "pdflatex"
            ]
        },
        {
            "name": "latexmk 🔃",
            "tools": [
                "latexmk"
            ]
        }
    ]
}
